# Copy this file to .env.local and adjust if needed. All three APIs are
# public and need no key — these vars are read by Next.js Route Handlers
# (see app/api/**/route.ts), not the browser.

POSTCODE_API_BASE_URL=http://api.getthedata.com/postcode
CRIME_API_BASE_URL=https://data.police.uk/api
# Used only for search-bar autocomplete suggestions as you type — the actual
# postcode -> lat/lng lookup still goes through getthedata.com above.
POSTCODE_AUTOCOMPLETE_BASE_URL=https://api.postcodes.io/postcodes
